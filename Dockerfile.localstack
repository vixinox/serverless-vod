# ── Stage 1: 获取完全静态链接的 ffmpeg 二进制（无任何共享库依赖）──────────────
FROM mwader/static-ffmpeg:latest AS static-ffmpeg

# ── Stage 2: LocalStack 主镜像 ─────────────────────────────────────────────
FROM localstack/localstack:latest

ARG APT_MIRROR=deb.debian.org

RUN set -eux; \
    if [ -f /etc/apt/sources.list ]; then \
        sed -i "s|http://deb.debian.org/debian|http://${APT_MIRROR}/debian|g" /etc/apt/sources.list; \
    fi; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i "s|http://deb.debian.org/debian|http://${APT_MIRROR}/debian|g" /etc/apt/sources.list.d/debian.sources; \
    fi; \
    printf 'Acquire::Retries "5";\nAcquire::http::Timeout "20";\nAcquire::https::Timeout "20";\n' > /etc/apt/apt.conf.d/99-retries; \
    apt-get update -y; \
    apt-get install -y --no-install-recommends ffmpeg; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# 将静态 ffmpeg 放到镜像文件系统（不在 volume 路径下），供 init hook 使用
COPY --from=static-ffmpeg /ffmpeg /opt/static-ffmpeg/ffmpeg
RUN chmod +x /opt/static-ffmpeg/ffmpeg

# LocalStack ready 钩子：容器启动就绪后，将静态 ffmpeg 复制到 localstack_data 卷中
# Lambda 容器通过 --volumes-from=localstack 访问该卷（/var/lib/localstack/bin/ffmpeg）
RUN mkdir -p /etc/localstack/init/ready.d && \
    printf '#!/bin/sh\n\
set -e\n\
mkdir -p /var/lib/localstack/bin\n\
cp /opt/static-ffmpeg/ffmpeg /var/lib/localstack/bin/ffmpeg\n\
chmod +x /var/lib/localstack/bin/ffmpeg\n\
echo "[init] static ffmpeg ready at /var/lib/localstack/bin/ffmpeg"\n' \
    > /etc/localstack/init/ready.d/01-ffmpeg.sh && \
    chmod +x /etc/localstack/init/ready.d/01-ffmpeg.sh
