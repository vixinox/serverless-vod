ARG LOCALSTACK_IMAGE=localstack/localstack
ARG LOCALSTACK_TAG=2026.03.0

# ── Stage 1: 获取完全静态链接的 ffmpeg 二进制（无任何共享库依赖）──────────────
FROM mwader/static-ffmpeg:latest AS static-ffmpeg

# ── Stage 2: LocalStack 主镜像 ─────────────────────────────────────────────
FROM ${LOCALSTACK_IMAGE}:${LOCALSTACK_TAG}

# 将静态 ffmpeg 和 ffprobe 放到镜像文件系统（不在 volume 路径下），供 init hook 使用
COPY --from=static-ffmpeg /ffmpeg  /opt/static-ffmpeg/ffmpeg
COPY --from=static-ffmpeg /ffprobe /opt/static-ffmpeg/ffprobe
RUN chmod +x /opt/static-ffmpeg/ffmpeg /opt/static-ffmpeg/ffprobe

# LocalStack ready 钉子：容器启动就绪后，将静态 ffmpeg/ffprobe 复制到 localstack_data 卷中
# Lambda 容器通过 --volumes-from=localstack 访问该卷（/var/lib/localstack/bin/）
RUN mkdir -p /etc/localstack/init/ready.d && \
    printf '#!/bin/sh\n\
set -e\n\
mkdir -p /var/lib/localstack/bin\n\
cp /opt/static-ffmpeg/ffmpeg  /var/lib/localstack/bin/ffmpeg\n\
cp /opt/static-ffmpeg/ffprobe /var/lib/localstack/bin/ffprobe\n\
chmod +x /var/lib/localstack/bin/ffmpeg /var/lib/localstack/bin/ffprobe\n\
echo "[init] static ffmpeg/ffprobe ready at /var/lib/localstack/bin/"\n' \
    > /etc/localstack/init/ready.d/01-ffmpeg.sh && \
    chmod +x /etc/localstack/init/ready.d/01-ffmpeg.sh
