generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Visibility {
  PUBLIC
  PRIVATE
  UNLISTED
  DRAFT
}

enum ReactionType {
  LIKE
  DISLIKE
}

enum VideoType {
  LONG
  SHORT
}

enum VideoProcessingStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum UploadSessionStatus {
  INITIATED
  PART_UPLOADING
  COMPLETED
  ABORTED
  EXPIRED
}

enum TranscodeJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum TranscodeProvider {
  LOCALSTACK
  AWS
}

enum VideoAssetType {
  SOURCE
  HLS_MASTER
  HLS_VARIANT
  MP4
  THUMBNAIL
  POSTER
}

enum PlaybackEventType {
  PLAY_START
  PLAY_PROGRESS
  PAUSE
  RESUME
  SEEK
  ENDED
  BUFFER_START
  BUFFER_END
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum SystemPlaylistKey {
  WATCH_LATER
  FAVORITES
}

/// 用户设置表：保存主题等用户级偏好，不参与视频业务主流程。
model UserSettings {
  userId    String          @id
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme     ThemePreference @default(SYSTEM)
  updatedAt DateTime        @updatedAt

  @@map("user_settings")
}

/// 用户表：Better Auth 用户主体，同时关联频道、视频、评论和播放行为。
model User {
  id               String               @id
  name             String
  email            String               @unique
  emailVerified    Boolean
  image            String?
  createdAt        DateTime
  updatedAt        DateTime
  sessions         Session[]
  accounts         Account[]
  channel          Channel?             @relation("UserChannel")
  comments         Comment[]
  videoReactions   VideoReaction[]
  commentReactions CommentReaction[]
  subscriptions    Subscription[]       @relation("UserSubscriptions")
  playlists        Playlist[]
  uploadSessions   UploadSession[]
  videos           Video[]
  playlistItems    PlaylistItem[]
  playbackEvents   VideoPlaybackEvent[]
  settings         UserSettings?

  @@map("user")
}

/// 登录会话表：Better Auth 维护的登录态记录。
model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

/// 账号绑定表：Better Auth 维护邮箱密码和第三方 OAuth 账号。
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

/// 验证凭据表：Better Auth 用于邮箱验证、重置等临时凭据。
model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

/// 频道表：创作者的内容主页，承载视频列表和订阅统计。
model Channel {
  id               String             @id @default(cuid())
  ownerId          String             @unique
  owner            User               @relation("UserChannel", fields: [ownerId], references: [id], onDelete: Cascade)
  name             String             @unique
  banner           String?
  description      String?
  videos           Video[]
  subscriptions    Subscription[]
  subscribersCount Int                @default(0)
  dailyStats       ChannelDailyStat[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

/// 订阅关系表：记录用户订阅频道，并由数据库触发器维护订阅数。
model Subscription {
  id           String   @id @default(cuid())
  subscriberId String
  channelId    String
  subscriber   User     @relation("UserSubscriptions", fields: [subscriberId], references: [id], onDelete: Cascade)
  channel      Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([subscriberId, channelId])
  @@index([subscriberId])
  @@index([channelId])
}

/// 视频内容表：保存视频基础信息、可见性、处理状态和互动计数。
model Video {
  id               String                @id @default(cuid())
  title            String
  description      String?
  shortCode        String                @unique
  thumbnail        String?
  duration         Int?
  type             VideoType             @default(LONG)
  visibility       Visibility            @default(DRAFT)
  processingStatus VideoProcessingStatus @default(UPLOADING)
  publishAt        DateTime?
  publishedAt      DateTime?
  readyAt          DateTime?
  processingError  String?
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  channelId        String
  channel          Channel               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  views            BigInt                @default(0)
  likesCount       Int                   @default(0)
  dislikesCount    Int                   @default(0)
  commentsCount    Int                   @default(0)
  reactions        VideoReaction[]
  comments         Comment[]
  assets           VideoAsset[]
  uploadSessions   UploadSession[]
  transcodeJobs    TranscodeJob[]
  dailyStats       VideoDailyStat[]
  playbackEvents   VideoPlaybackEvent[]
  playlistItems    PlaylistItem[]
  deletedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([channelId])
  @@index([userId])
  @@index([visibility, createdAt])
  @@index([channelId, createdAt])
  @@index([userId, createdAt])
  @@index([processingStatus])
}

/// 视频互动表：一名用户对一个视频只能保留一个点赞或点踩状态。
model VideoReaction {
  userId       String
  videoId      String
  reactionType ReactionType
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  video        Video        @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([videoId])
}

/// 评论表：同时承载一级评论和二级回复，parentId 为空时为一级评论。
model Comment {
  id            String            @id @default(cuid())
  content       String            @db.Text
  userId        String
  videoId       String
  parentId      String?
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  video         Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  parent        Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       Comment[]         @relation("CommentReplies")
  repliesCount  Int               @default(0)
  reactions     CommentReaction[]
  likesCount    Int               @default(0)
  dislikesCount Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  @@index([videoId])
  @@index([userId])
  @@index([parentId])
}

/// 评论互动表：一名用户对一条评论只能保留一个点赞或点踩状态。
model CommentReaction {
  userId       String
  commentId    String
  reactionType ReactionType
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment      Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
  @@index([commentId])
}

/// 播放列表表：同时支持用户自定义列表和系统列表。
model Playlist {
  id          String             @id @default(cuid())
  ownerId     String
  owner       User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isPublic    Boolean            @default(true)
  systemKey   SystemPlaylistKey?
  items       PlaylistItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([ownerId, systemKey])
  @@index([ownerId])
  @@index([ownerId, createdAt])
  @@index([ownerId, systemKey])
  @@index([ownerId, isPublic, updatedAt])
}

/// 播放列表条目表：记录视频在某个播放列表中的顺序。
model PlaylistItem {
  id         String   @id @default(cuid())
  playlistId String
  videoId    String
  addedById  String
  position   Int
  createdAt  DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  addedBy    User     @relation(fields: [addedById], references: [id], onDelete: Cascade)

  @@unique([playlistId, position])
  @@unique([playlistId, videoId])
  @@index([playlistId])
  @@index([playlistId, createdAt])
  @@index([videoId])
  @@index([addedById])
}

/// 视频日统计表：从播放事件和互动记录汇总而来，供单视频分析页读取。
model VideoDailyStat {
  id               String   @id @default(cuid())
  videoId          String
  date             DateTime @db.Date
  views            BigInt   @default(0)
  uniqueViewers    Int      @default(0)
  watchTimeSeconds BigInt   @default(0)
  likesGained      Int      @default(0)
  dislikesGained   Int      @default(0)
  commentsGained   Int      @default(0)
  video            Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([videoId, date])
  @@index([date])
}

/// 频道日统计表：把频道下的视频日统计继续聚合成创作者看板数据。
model ChannelDailyStat {
  id                String   @id @default(cuid())
  channelId         String
  date              DateTime @db.Date
  views             BigInt   @default(0)
  watchTimeSeconds  BigInt   @default(0)
  subscribersGained Int      @default(0)
  subscribersLost   Int      @default(0)
  videosPublished   Int      @default(0)
  channel           Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, date])
  @@index([date])
}

/// 上传会话表：记录一次浏览器直传 vod-raw 的对象位置和过期时间。
model UploadSession {
  id                String              @id @default(cuid())
  videoId           String
  uploaderId        String
  storageBucket     String
  objectKey         String
  multipartUploadId String?
  partCount         Int                 @default(0)
  status            UploadSessionStatus @default(INITIATED)
  expiresAt         DateTime
  completedAt       DateTime?
  abortedAt         DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  video             Video               @relation(fields: [videoId], references: [id], onDelete: Cascade)
  uploader          User                @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([uploaderId])
  @@index([status, expiresAt])
}

/// 转码任务表：记录一次 Step Functions 执行及其阶段、输入输出和失败原因。
model TranscodeJob {
  id             String             @id @default(cuid())
  videoId        String
  provider       TranscodeProvider  @default(LOCALSTACK)
  queueMessageId String?
  inputBucket    String
  inputKey       String
  outputBucket   String
  outputPrefix   String
  status         TranscodeJobStatus @default(QUEUED)
  attempt        Int                @default(0)
  maxAttempts    Int                @default(3)
  pipelineStage  String?
  lastError      String?
  queuedAt       DateTime           @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  video          Video              @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([status, queuedAt])
  @@index([provider, status])
}

/// 视频资源表：保存源文件、HLS 主清单、封面等对象存储产物。
model VideoAsset {
  id            String         @id @default(cuid())
  videoId       String
  assetType     VideoAssetType
  qualityLabel  String?
  mimeType      String?
  codec         String?
  bitrateKbps   Int?
  width         Int?
  height        Int?
  duration      Int?
  storageBucket String
  storageKey    String
  sizeBytes     BigInt?
  checksum      String?
  isPrimary     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  video         Video          @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
  @@index([assetType])
  @@index([videoId, assetType])
}

/// 播放事件表：播放器的原始埋点日志
model VideoPlaybackEvent {
  id              String            @id @default(cuid())
  videoId         String
  userId          String?
  sessionId       String
  eventType       PlaybackEventType
  positionSeconds Int?
  durationSeconds Int?
  watchDeltaMs    Int?
  playbackRate    Decimal?          @db.Decimal(4, 2)
  isMuted         Boolean?
  volume          Int?
  qualityLabel    String?
  source          String?
  referrer        String?
  userAgent       String?
  ipHash          String?
  countryCode     String?
  createdAt       DateTime          @default(now())
  video           Video             @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([videoId, createdAt])
  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@index([eventType, createdAt])
}
